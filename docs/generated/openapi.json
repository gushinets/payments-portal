              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entrypoint Type"
          },
          "entrypoint_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entrypoint Value"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          }
        },
        "required": [
          "document_version_id",
          "acceptance_text_hash"
        ],
        "title": "AcceptDocumentRequest",
        "type": "object"
      },
      "CheckoutAction": {
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount",
            "type": "string"
          },
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "experience": {
            "enum": [
              "widget",
              "redirect",
              "embedded"
            ],
            "title": "Experience",
            "type": "string"
          },
          "merchant_order_id": {
            "title": "Merchant Order Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "provider_invoice_id": {
            "title": "Provider Invoice Id",
            "type": "string"
          },
          "public_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Identifier"
          }
        },
        "required": [
          "provider",
          "experience",
          "mode",
          "public_identifier",
          "amount_minor",
          "amount",
          "currency",
          "merchant_order_id",
          "provider_invoice_id",
          "account_id"
        ],
        "title": "CheckoutAction",
        "type": "object"
      },
      "CheckoutIntentCheckoutResponse": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/CheckoutAction"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "amount_minor": {
            "minimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
