# Production runtime baseline: Node.js 24 LTS and PostgreSQL 18.4.
# PostgreSQL 18 Compose volumes mount at /var/lib/postgresql; the image default
# PGDATA is /var/lib/postgresql/18/docker.
APP_ENV=production
# The current legal/bootstrap source supports exactly this deployed scope.
# Any other INSTANCE_TENANT_ID / INSTANCE_REGION pair fails startup and migration.
INSTANCE_TENANT_ID=
INSTANCE_REGION=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_USER=

# Canonical public Portal origin used by API links and web metadata
APP_PUBLIC_BASE_URL=
# Caddy public entrypoint
CADDY_DOMAIN=
CORS_ALLOW_ORIGINS=
FORWARDED_ALLOW_IPS=*

# Private billing connection (all empty keeps billing unavailable).
LBX_BASE_URL=
LBX_SERVER_USERNAME=
LBX_SERVER_PASSWORD=
# Later Widget/purchase readiness only; does not gate Server API reads/linking.
LBX_WIDGET_SIGNING_SECRET=
LBX_SELLER_ORGANIZATION_ID=
# Price start dates use Europe/Moscow, confirmed by LBX support; no timezone setting.
# Set the actual provider currency ID for the supported RUB major-units/scale-2 contract.
LBX_CURRENCY_ID=1
LBX_CURRENCY=RUB
MAPPING_OPERATOR_LOCK_FILE=/run/payments-portal/operator.lock
# Real Kernel enablement remains ANY-711; never enable the dev mock here.
KERNEL_MOCK_ENABLED=0
KERNEL_BASE_URL=
KERNEL_SERVICE_TOKEN=

# Frontend public values are captured during the Docker web image build
NEXT_PUBLIC_API_BASE_URL=
# Optional frontend error reporting; empty keeps Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TELEGRAM_LOGIN_URL=

# Password reset email
SMTP_FROM_EMAIL=support@any-tool-ai.ru
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=anytoolai-payment-portal-api

# Backend application error reporting (release is required when DSN is set)
SENTRY_DSN=
SENTRY_RELEASE=
