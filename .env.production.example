# Production runtime baseline: Node.js 24 LTS and PostgreSQL 18.4.
# PostgreSQL 18 Compose volumes mount at /var/lib/postgresql; the image default
# PGDATA is /var/lib/postgresql/18/docker.
APP_ENV=production
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Caddy public entrypoint
CADDY_DOMAIN=
CORS_ALLOW_ORIGINS=
APP_PUBLIC_BASE_URL=
FORWARDED_ALLOW_IPS=*

# Frontend public values are captured during the Docker web image build
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_TELEGRAM_LOGIN_URL=

# Password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@any-tool-ai.ru
SMTP_USE_TLS=true

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_ENABLED=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=anytoolai-payment-portal-api
