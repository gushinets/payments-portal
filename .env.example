# Shared local defaults for the Docker API container.
# Runtime baseline: Node.js 24 LTS and PostgreSQL 18.4.
APP_ENV=development
INSTANCE_TENANT_ID=anytoolai
INSTANCE_REGION=ru
DATABASE_URL=postgresql+psycopg://anytoolai:anytoolai@postgres:5432/anytoolai

POSTGRES_DB_TEST=anytoolai_test
POSTGRES_HOST_TEST=127.0.0.1
POSTGRES_PASSWORD_TEST=anytoolai
POSTGRES_PORT_TEST=5432
POSTGRES_USER_TEST=anytoolai
# Optional explicit test DSN; when nonempty, takes precedence over POSTGRES_*_TEST.
TEST_POSTGRES_DATABASE_URL=

# PostgreSQL 18 container. Compose mounts the named volume at
# /var/lib/postgresql so the image default PGDATA stays /var/lib/postgresql/18/docker.
POSTGRES_DB=anytoolai
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=anytoolai
POSTGRES_PORT=5432
POSTGRES_USER=anytoolai

# Local HTTP entrypoints
API_PORT=8000
APP_PUBLIC_BASE_URL=http://localhost:3000
CADDY_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000
# Direct local Compose only; the agent override routes Caddy to web:3000.
WEB_UPSTREAM=host.docker.internal:3000
# Production-only public domain; see .env.production.example for deployment.
CADDY_DOMAIN=
FORWARDED_ALLOW_IPS=*

# Normal server-only LBX connection. Empty means billing is unavailable.
LBX_BASE_URL=
LBX_SERVER_USERNAME=
LBX_SERVER_PASSWORD=
# Account Widget requires the signing secret; neither field gates Server API reads.
LBX_WIDGET_SIGNING_SECRET=
# Seller organization is required by later purchase operations.
LBX_SELLER_ORGANIZATION_ID=
# Price start dates use Europe/Moscow, confirmed by LBX support; no timezone setting.
# Typed RUB major-units/scale-2 mapping; set the actual provider currency ID.
LBX_CURRENCY_ID=1
LBX_CURRENCY=RUB
LBX_CONNECT_TIMEOUT_SECONDS=1
LBX_READ_TIMEOUT_SECONDS=2
LBX_MAX_RESPONSE_BYTES=524288
# Includes auth and one reauthentication exchange for each logical GET.
LBX_MAX_GET_ATTEMPTS=5
LBX_RETRY_DELAY_SECONDS=0.1
LBX_MAX_RETRY_DELAY_SECONDS=2

# Kernel connection; enable the technical mock only for explicit development.
KERNEL_MOCK_ENABLED=0
KERNEL_BASE_URL=
KERNEL_SERVICE_TOKEN=
KERNEL_MOCK_TOKEN=
KERNEL_MOCK_SCENARIO=valid
KERNEL_MOCK_DELAY_SECONDS=30
# KERNEL_MOCK_TOKEN must match KERNEL_SERVICE_TOKEN when the mock is enabled.
# KERNEL_MOCK_PORT is generated per worktree by the harness.

# Host API/CLI policy tuning. These are the current Settings defaults;
# Compose currently uses code defaults for this block rather than forwarding it.
PREFLIGHT_TOTAL_TIMEOUT_SECONDS=10
PREFLIGHT_CLEANUP_TIMEOUT_SECONDS=0.25
PREFLIGHT_MAX_ACTIVE=8
PREFLIGHT_MAX_WAITING=8
KERNEL_CONNECT_TIMEOUT_SECONDS=1
KERNEL_READ_TIMEOUT_SECONDS=2
KERNEL_MAX_RESPONSE_BYTES=262144
KERNEL_MAX_RETRIES=1
KERNEL_RETRY_DELAY_SECONDS=0.1
MAPPING_LOCK_TIMEOUT_SECONDS=2

# Privileged CLI only; the actual OS UID identifies the author in audit records.
# Provision one trusted shared directory, then set its absolute lock file path.
# Containers use /run/payments-portal/operator.lock by default. Host CLI processes
# must use the corresponding absolute .harness/operator/operator.lock host path.
MAPPING_OPERATOR_LOCK_FILE=

# Frontend public values are captured when Next.js starts/builds
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.102
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Optional frontend error reporting; empty keeps Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TELEGRAM_LOGIN_URL=

# Password reset email. Empty SMTP_HOST disables delivery without logging tokens.
SMTP_FROM_EMAIL=support@any-tool-ai.ru
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=

# Observability and optional error reporting; never put real secrets in examples.
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=payment-portal-api
SENTRY_DSN=
SENTRY_RELEASE=
# Optional local agent observability image; the harness generates its port set.
OTEL_LGTM_IMAGE=grafana/otel-lgtm:0.30.1

# Normal API startup seeds the current legal documents. Test harnesses set true.
SKIP_LEGAL_SEED=false
