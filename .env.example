# Shared local defaults for the Docker API container.
# Runtime baseline: Node.js 24 LTS and PostgreSQL 18.4.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://anytoolai:anytoolai@postgres:5432/anytoolai

POSTGRES_DB_TEST=anytoolai_test
POSTGRES_PASSWORD_TEST=anytoolai
POSTGRES_PORT_TEST=5432
POSTGRES_USER_TEST=anytoolai

# PostgreSQL 18 container. Compose mounts the named volume at
# /var/lib/postgresql so the image default PGDATA stays /var/lib/postgresql/18/docker.
POSTGRES_DB=anytoolai
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=anytoolai
POSTGRES_PORT=5432
POSTGRES_USER=anytoolai

# Local HTTP entrypoints
API_PORT=8000
APP_PUBLIC_BASE_URL=http://localhost:3000
CADDY_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000

# Frontend public values are captured when Next.js starts/builds
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.102
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_TELEGRAM_LOGIN_URL=

# Password reset email. Empty SMTP_HOST disables delivery without logging tokens.
SMTP_FROM_EMAIL=support@any-tool-ai.ru
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=

# CloudPayments demo mode by default
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_ENABLED=false
CLOUDPAYMENTS_PUBLIC_ID=
